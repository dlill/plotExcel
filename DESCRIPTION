    openxlsx,
    data.table,
    tools,
    git2r,
    pdftools,
    magick,
    stats
Suggests: 
    ggplot2,
    testthat (>= 3.0.0),
    rstudioapi,
    RSAddins
Config/testthat/edition: 3
URL: https://github.com/dlill/plotExcel
